---
import "../styles/global.css";
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="BearUang API - Template Toko Online yang Bisa Anda Bangun. Kembangkan bisnis e-commerce dengan API yang bersih, cepat, dan mudah diintegrasikan."
		/>
		<title>BearUang — Template Toko Online</title>
	</head>
	<body class="min-h-screen bg-background font-sans antialiased">
		<div class="relative flex min-h-screen flex-col">
			<header
				class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60"
			>
				<div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
					<div class="flex items-center gap-2">
						<span class="text-lg font-semibold tracking-tight">BearUang</span>
					</div>
					<nav class="flex items-center gap-6 text-sm">
						<a href="#fitur" class="text-muted-foreground transition-colors hover:text-foreground"
							>Fitur</a
						>
						<a href="#demo" class="text-muted-foreground transition-colors hover:text-foreground"
							>Demo</a
						>
						<a href="#mulai" class="text-muted-foreground transition-colors hover:text-foreground"
							>Mulai</a
						>
					</nav>
				</div>
			</header>

			<main class="flex-1">
				<section class="relative mx-auto max-w-7xl px-4 pt-20 sm:px-6 sm:pt-24 lg:px-8 lg:pt-32">
					<div class="mx-auto max-w-3xl">
						<p
							class="mb-4 text-sm font-medium tracking-widest text-muted-foreground uppercase"
							style="animation: fade-in 500ms ease-out forwards; animation-delay: 0ms; opacity: 0;"
						>
							Template E-Commerce
						</p>
						<h1
							class="text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl"
							style="animation: slide-up 600ms ease-out forwards; animation-delay: 100ms; opacity: 0;"
						>
							Bangun toko online<br class="hidden sm:block" /> dengan API yang bersih
						</h1>
						<p
							class="mt-6 max-w-xl text-lg text-muted-foreground"
							style="animation: slide-up 600ms ease-out forwards; animation-delay: 200ms; opacity: 0;"
						>
							Template siap pakai yang bisa Anda customize. E-commerce yang cepat, aksesibel, dan
							mudah diintegrasikan dengan sistem pembayaran mana pun.
						</p>
						<div
							class="mt-10 flex flex-col gap-4 sm:flex-row"
							style="animation: slide-up 600ms ease-out forwards; animation-delay: 300ms; opacity: 0;"
						>
							<a
								href="#demo"
								class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
							>
								Lihat Demo
							</a>
							<a
								href="#mulai"
								class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-background px-8 text-sm font-medium shadow-xs transition-colors hover:bg-muted hover:text-foreground"
							>
								Baca Dokumentasi
							</a>
						</div>
					</div>
				</section>

				<section id="demo" class="mx-auto mt-20 max-w-7xl px-4 sm:mt-24 sm:px-6 lg:mt-32 lg:px-8">
					<div
						class="rounded-lg border border-border bg-card text-card-foreground shadow-sm"
						style="animation: fade-in 800ms ease-out forwards; animation-delay: 400ms; opacity: 0;"
					>
						<div class="flex items-center justify-between border-b border-border px-4 py-3">
							<div class="flex items-center gap-2">
								<div class="h-3 w-3 rounded-full bg-destructive"></div>
								<div class="h-3 w-3 rounded-full bg-[oklch(0.75_0.15_85)]"></div>
								<div class="h-3 w-3 rounded-full bg-[oklch(0.72_0.19_145)]"></div>
							</div>
							<span class="rounded bg-muted px-2 py-1 text-xs text-muted-foreground"
								>bearuang.store</span
							>
						</div>
						<div class="p-6 sm:p-8">
							<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
								<div class="space-y-3">
									<div class="aspect-4/3 rounded-md bg-muted"></div>
									<div class="h-4 w-3/4 rounded bg-muted"></div>
									<div class="h-3 w-1/2 rounded bg-muted"></div>
								</div>
								<div class="space-y-3">
									<div class="aspect-4/3 rounded-md bg-muted"></div>
									<div class="h-4 w-3/4 rounded bg-muted"></div>
									<div class="h-3 w-1/2 rounded bg-muted"></div>
								</div>
								<div class="space-y-3 sm:col-span-2 lg:col-span-1">
									<div class="aspect-4/3 rounded-md bg-muted"></div>
									<div class="h-4 w-3/4 rounded bg-muted"></div>
									<div class="h-3 w-1/2 rounded bg-muted"></div>
								</div>
							</div>
							<div class="mt-8 flex items-center justify-between border-t border-border pt-6">
								<div class="flex items-center gap-4">
									<div class="h-10 w-10 rounded-full bg-muted"></div>
									<div class="space-y-1.5">
										<div class="h-3.5 w-24 rounded bg-muted"></div>
										<div class="h-3 w-16 rounded bg-muted"></div>
									</div>
								</div>
								<div class="flex gap-2">
									<div class="h-9 w-20 rounded bg-muted"></div>
									<div class="h-9 w-9 rounded bg-muted"></div>
								</div>
							</div>
						</div>
					</div>
				</section>

				<section id="fitur" class="mx-auto mt-20 max-w-7xl px-4 sm:mt-24 sm:px-6 lg:mt-32 lg:px-8">
					<div class="mx-auto max-w-2xl text-center">
						<h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
							Fitur yang Anda dapatkan
						</h2>
						<p class="mt-4 text-muted-foreground">
							Segala yang Anda butuhkan untuk memulai toko online yang cepat dan profesional.
						</p>
					</div>
					<div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
						<div class="relative p-6">
							<div
								class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md bg-muted"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-muted-foreground"
									><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg
								>
							</div>
							<h3 class="mb-2 font-medium">Cepat dan Ringan</h3>
							<p class="text-sm text-muted-foreground">
								Dirender di server untuk performa terbaik. Waktu muat instan, SEO maksimal.
							</p>
						</div>
						<div class="relative p-6">
							<div
								class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md bg-muted"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-muted-foreground"
									><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path
										d="m9 12 2 2 4-4"></path></svg
								>
							</div>
							<h3 class="mb-2 font-medium">Aksesibel Default</h3>
							<p class="text-sm text-muted-foreground">
								WCAG AA compliant. Navigasi keyboard, screen reader friendly, kontras tinggi.
							</p>
						</div>
						<div class="relative p-6">
							<div
								class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md bg-muted"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-muted-foreground"
									><path
										d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"
									></path><path d="M18 14h-8"></path><path d="M15 18h-5"></path><path
										d="M10 6h8v4h-8V6Z"></path></svg
								>
							</div>
							<h3 class="mb-2 font-medium">Desain Minimal</h3>
							<p class="text-sm text-muted-foreground">
								Pragaati canvas yang siap Anda customize dengan branding Anda sendiri.
							</p>
						</div>
						<div class="relative p-6">
							<div
								class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md bg-muted"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-muted-foreground"
									><path d="M12 3v12"></path><path d="m8 11 4 4 4-4"></path><path
										d="M8 5H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-4"
									></path></svg
								>
							</div>
							<h3 class="mb-2 font-medium">Integrasi Mudah</h3>
							<p class="text-sm text-muted-foreground">
								Satu endpoint API untuk semua kebutuhan pembayaran. Sambungkan ke BearUang atau
								provider lain.
							</p>
						</div>
						<div class="relative p-6">
							<div
								class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md bg-muted"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-muted-foreground"
									><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M7 7h10"
									></path><path d="M7 12h10"></path><path d="M7 17h10"></path></svg
								>
							</div>
							<h3 class="mb-2 font-medium">Dashboard</h3>
							<p class="text-sm text-muted-foreground">
								Kelola produk, pesanan, dan pembayaran dari satu tempat yang bersih.
							</p>
						</div>
						<div class="relative p-6">
							<div
								class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md bg-muted"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-muted-foreground"
									><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle
										cx="9"
										cy="7"
										r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
										d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
								>
							</div>
							<h3 class="mb-2 font-medium">Multi-penyewa</h3>
							<p class="text-sm text-muted-foreground">
								Arsitektur siap untuk multi-tenant. Satu instance, banyak toko.
							</p>
						</div>
					</div>
				</section>

				<section id="mulai" class="mx-auto mt-20 max-w-7xl px-4 sm:mt-24 sm:px-6 lg:mt-32 lg:px-8">
					<div class="relative overflow-hidden rounded-lg border border-border bg-card">
						<div class="p-6 sm:p-8">
							<div class="mx-auto max-w-2xl text-center">
								<h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
									Mulai dalam hitungan menit
								</h2>
								<p class="mt-4 text-muted-foreground">
									Template ini menggunakan API BearUang untuk pembayaran. Daftar gratis dan dapatkan
									API key.
								</p>
							</div>
							<div class="mt-8">
								<div class="rounded-md bg-muted/50 p-4 font-mono text-sm">
									<div class="flex items-center gap-2 text-muted-foreground">
										<span class="text-primary">const</span>
										<span>response</span>
										<span class="text-muted-foreground">=</span>
										<span class="text-primary">await</span>
										<span>fetch</span>
										<span class="text-muted-foreground">(</span>
										<span class="text-[hsl(210,80%,55%)]"
											>'https://api.bearuang.com/v1/checkout'</span
										>
										<span class="text-muted-foreground">,</span>
									</div>
									<div class="ml-6 flex items-center gap-2 text-muted-foreground">
										<span
											>{}
											<span class="text-[hsl(210,80%,55%)]">'method'</span>
											<span class="text-muted-foreground">:</span>
											<span class="text-[hsl(210,80%,55%)]">'POST'</span>
											<span class="text-muted-foreground">,</span>
										</span>
										<div class="ml-6 flex items-center gap-2 text-muted-foreground">
											<span class="text-[hsl(210,80%,55%)]">'headers'</span>
											<span class="text-muted-foreground">:</span>
											<span
												>{}
												<span class="text-[hsl(210,80%,55%)]">'Authorization'</span>
												<span class="text-muted-foreground">:</span>
												<span class="text-[hsl(210,80%,55%)]">'Bearer YOUR_API_KEY'</span>
												<span></span></span
											>
										</div>
										<div class="ml-6 flex items-center gap-2 text-muted-foreground">
											<span></span>
										</div>
										<span>)</span>
									</div>
								</div>
								<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-center">
									<a
										href="#"
										class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90"
									>
										Daftar Gratis
									</a>
									<a
										href="#"
										class="inline-flex h-10 items-center justify-center text-sm font-medium text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
									>
										Baca Dokumentasi Lengkap
									</a>
								</div>
							</div>
						</div>
					</div>
				</section>

				<section
					class="mx-auto mt-20 max-w-7xl px-4 py-12 sm:mt-24 sm:px-6 sm:py-16 lg:mt-32 lg:px-8"
				>
					<div class="mx-auto max-w-3xl text-center">
						<p class="text-sm text-muted-foreground">
							Dibangun dengan Astro dan React. Desain referensi dari shadcn/ui dan Radix.
						</p>
					</div>
				</section>
			</main>
		</div>

		<style>
			@keyframes fade-in {
				from {
					opacity: 0;
				}
				to {
					opacity: 1;
				}
			}
			@keyframes slide-up {
				from {
					opacity: 0;
					transform: translateY(16px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-delay: 0ms !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>
	</body>
</html>
