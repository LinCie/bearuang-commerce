---
import Layout from "@/layouts/Layout.astro";
import { ProductCard } from "@/components/ui/product-card";
import type { StockStatus } from "@/components/ui/product-card";
import { localClient } from "@/lib/api-client";
import type { ProductsResponse } from "@/lib/types/product";

const response = await localClient
	.get<ProductsResponse>("products", {
		searchParams: { page: "1", pageSize: "8", sortBy: "createdAt", sortOrder: "desc" },
	})
	.json();

const products = response.data.map((product) => {
	const primaryImage =
		product.images[0]?.media.url ??
		"https://images.unsplash.com/photo-1589310243389-96a5483213a8?w=600&h=600&fit=crop";
	const primaryVariant = product.variants[0];
	const stock = primaryVariant?.stock ?? 0;
	const stockStatus: StockStatus =
		stock === 0 ? "out_of_stock" : stock <= 5 ? "low_stock" : "in_stock";

	return {
		id: product.id,
		name: product.name,
		description: product.description,
		price: primaryVariant?.price ?? 0,
		image: primaryImage,
		stock: stockStatus,
		stockCount: stock,
		slug: product.slug,
	};
});
---

<Layout title="BearUang — Template Toko Online">
	<div>
		<section
			class="mx-auto max-w-7xl px-4 pt-24 pb-20 sm:px-6 sm:pt-32 sm:pb-24 lg:px-8 lg:pt-40 lg:pb-32"
		>
			<div class="max-w-2xl" data-stagger>
				<p class="text-xs font-medium tracking-[0.2em] text-muted-foreground uppercase">
					Template E-Commerce
				</p>
				<h1
					class="mt-6 text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.1] font-semibold tracking-tight"
				>
					Bangun toko online dengan API yang bersih
				</h1>
				<p class="mt-6 max-w-lg text-[1.0625rem] leading-relaxed text-muted-foreground">
					Template siap pakai yang bisa Anda customize. E-commerce yang cepat, aksesibel, dan mudah
					diintegrasikan dengan sistem pembayaran mana pun.
				</p>
				<div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
					<a
						href="/signup"
						class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
					>
						Daftar Gratis
					</a>
					<a
						href="#demo"
						class="inline-flex h-10 items-center justify-center rounded-md px-6 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
					>
						Lihat Demo
					</a>
				</div>
			</div>
		</section>

		<section id="demo" class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8 lg:pb-32">
			<div data-stagger>
				<div class="overflow-hidden rounded-lg border border-border">
					<div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
						<div class="flex items-center gap-1.5">
							<div class="h-2.5 w-2.5 rounded-full bg-[oklch(0.65_0.15_25)]"></div>
							<div class="h-2.5 w-2.5 rounded-full bg-[oklch(0.75_0.12_85)]"></div>
							<div class="h-2.5 w-2.5 rounded-full bg-[oklch(0.7_0.15_145)]"></div>
						</div>
						<span class="ml-2 text-xs text-muted-foreground">bearuang.store</span>
					</div>
					<div class="p-6 sm:p-10">
						<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
							{
								products.map((product) => (
									<ProductCard
										client:load
										imageUrl={product.image}
										productName={product.name}
										description={product.description}
										price={product.price}
										stock={product.stock}
										stockCount={product.stockCount}
										href={`/products/${product.slug}`}
										onAddToCart={() => console.log("Add to cart:", product.id)}
										onWishlist={() => console.log("Wishlist:", product.id)}
									/>
								))
							}
						</div>
						<div class="mt-8 flex items-center justify-between border-t border-border pt-6">
							<div class="flex items-center gap-3">
								<div class="h-8 w-8 rounded-full bg-muted/40"></div>
								<div class="space-y-1">
									<div class="h-2.5 w-20 rounded bg-muted/40"></div>
									<div class="h-2 w-14 rounded bg-muted/30"></div>
								</div>
							</div>
							<div class="flex gap-2">
								<div class="h-8 w-20 rounded-md bg-muted/40"></div>
								<div class="h-8 w-8 rounded-md bg-muted/30"></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="fitur" class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8 lg:pb-32">
			<div data-stagger>
				<div class="max-w-xl">
					<h2 class="text-2xl font-semibold tracking-tight sm:text-[1.75rem]">
						Fitur yang Anda dapatkan
					</h2>
					<p class="mt-3 text-muted-foreground">
						Segala yang Anda butuhkan untuk memulai toko online yang cepat dan profesional.
					</p>
				</div>
				<div
					class="mt-12 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2"
				>
					<div class="bg-background p-8">
						<h3 class="text-sm font-semibold tracking-tight">Cepat dan Ringan</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
							Dirender di server untuk performa terbaik. Waktu muat instan, SEO maksimal.
						</p>
					</div>
					<div class="bg-background p-8">
						<h3 class="text-sm font-semibold tracking-tight">Aksesibel Default</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
							WCAG AA compliant. Navigasi keyboard, screen reader friendly, kontras tinggi.
						</p>
					</div>
					<div class="bg-background p-8">
						<h3 class="text-sm font-semibold tracking-tight">Desain Minimal</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
							Prahati canvas yang siap Anda customize dengan branding Anda sendiri.
						</p>
					</div>
					<div class="bg-background p-8">
						<h3 class="text-sm font-semibold tracking-tight">Integrasi Mudah</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
							Satu endpoint API untuk semua kebutuhan pembayaran. Sambungkan ke BearUang atau
							provider lain.
						</p>
					</div>
					<div class="bg-background p-8">
						<h3 class="text-sm font-semibold tracking-tight">Dashboard</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
							Kelola produk, pesanan, dan pembayaran dari satu tempat yang bersih.
						</p>
					</div>
					<div class="bg-background p-8">
						<h3 class="text-sm font-semibold tracking-tight">Multi-penyewa</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
							Arsitektur siap untuk multi-tenant. Satu instance, banyak toko.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section id="mulai" class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8 lg:pb-32">
			<div data-stagger>
				<div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
					<div class="flex flex-col justify-center">
						<h2 class="text-2xl font-semibold tracking-tight sm:text-[1.75rem]">
							Mulai dalam hitungan menit
						</h2>
						<p class="mt-3 max-w-md text-muted-foreground">
							Template ini menggunakan API BearUang untuk pembayaran. Daftar gratis dan dapatkan API
							key.
						</p>
						<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
							<a
								href="/signup"
								class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
							>
								Daftar Gratis
							</a>
							<a
								href="#"
								class="inline-flex h-10 items-center justify-center text-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
							>
								Dokumentasi Lengkap
							</a>
						</div>
					</div>
					<div>
						<div
							class="rounded-lg border border-border bg-[oklch(0.97_0_0)] p-5 font-mono text-sm leading-relaxed"
						>
							<div>
								<span class="text-foreground/60">const</span>{" "}
								<span class="text-foreground">response</span>{" "}
								<span class="text-foreground/40">=</span>{" "}
								<span class="text-foreground/60">await</span>{" "}
								<span class="text-foreground">fetch</span><span class="text-foreground/40">(</span>
							</div>
							<div class="ml-4">
								<span class="text-foreground/70">'https://api.bearuang.com/v1/checkout'</span><span
									class="text-foreground/40">,</span
								>
							</div>
							<div class="ml-4">
								<span class="text-foreground/40">{"{"}</span>
							</div>
							<div class="ml-8">
								<span class="text-foreground/70">'method'</span><span class="text-foreground/40"
									>:</span
								>{" "}
								<span class="text-foreground/70">'POST'</span><span class="text-foreground/40"
									>,</span
								>
							</div>
							<div class="ml-8">
								<span class="text-foreground/70">'headers'</span><span class="text-foreground/40"
									>:</span
								>{" "}
								<span class="text-foreground/40">{"{"}</span>
							</div>
							<div class="ml-12">
								<span class="text-foreground/70">'Authorization'</span><span
									class="text-foreground/40">:</span
								>{" "}
								<span class="text-foreground/70">'Bearer YOUR_API_KEY'</span>
							</div>
							<div class="ml-8"><span class="text-foreground/40">{"}"}</span></div>
							<div class="ml-4"><span class="text-foreground/40">{"}"}</span></div>
							<div>
								<span class="text-foreground/40">)</span><span class="text-foreground/40">;</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<footer class="border-t border-border">
			<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
				<p class="text-xs text-muted-foreground">
					Dibangun dengan Astro dan React. Desain referensi dari shadcn/ui dan Radix.
				</p>
			</div>
		</footer>
	</div>

	<style>
		[data-stagger] {
			opacity: 0;
			transform: translateY(20px);
			animation: stagger-in 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
			animation-delay: calc(var(--i, 0) * 120ms);
		}

		section:first-child [data-stagger] {
			--i: 0;
		}
		section:nth-child(2) [data-stagger] {
			--i: 1;
		}
		section:nth-child(3) [data-stagger] {
			--i: 2;
		}
		section:nth-child(4) [data-stagger] {
			--i: 3;
		}

		@keyframes stagger-in {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			[data-stagger] {
				animation: none;
				opacity: 1;
				transform: none;
			}
		}
	</style>
</Layout>
