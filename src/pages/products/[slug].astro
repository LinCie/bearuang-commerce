---
import Layout from "@/layouts/Layout.astro";
import { ProductDetail } from "@/components/ui/product-detail";
import { localClient } from "@/lib/api-client";
import type { Product } from "@/lib/types/product";
import type { ProductDetailProps } from "@/components/ui/product-detail";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

let product: ProductDetailProps["product"] | null = null;
let error: string | null = null;

try {
	const response = await localClient.get<Product>(`products/${slug}`).json();
	product = {
		id: response.id,
		name: response.name,
		slug: response.slug,
		description: response.description,
		category: response.category,
		variants: response.variants.map((v) => ({
			id: v.id,
			sku: v.sku,
			name: v.name,
			price: v.price,
			stock: v.stock,
			unit: v.unit,
			attributes: v.attributes,
			isActive: v.isActive,
			images: v.images.map((img) => ({
				id: img.id,
				media: { url: img.media.url, altText: img.altText },
			})),
		})),
		images: response.images.map((img) => ({
			id: img.id,
			media: { url: img.media.url, altText: img.altText },
		})),
	};
} catch (err) {
	console.error(`[ProductPage] Failed to load product "${slug}":`, err);
	error = "Produk tidak ditemukan";
}

const handleAddToCart = (variantId: string, quantity: number) => {
	console.log("Add to cart:", { variantId, quantity });
};

const handleQuantityChange = (variantId: string, quantity: number) => {
	console.log("Quantity changed:", { variantId, quantity });
};
---

<Layout title={product ? `${product.name} — BearUang` : "Produk Tidak Ditemukan — BearUang"}>
	<div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
		{
			error ? (
				<div class="flex flex-col items-center justify-center py-20 text-center">
					<div class="rounded-full bg-muted p-4">
						<svg
							class="size-10 text-muted-foreground"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"
							/>
						</svg>
					</div>
					<h1 class="mt-4 text-xl font-semibold">Produk Tidak Ditemukan</h1>
					<p class="mt-2 text-muted-foreground">{error}</p>
					<a
						href="/"
						class="mt-6 inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
					>
						Kembali ke Beranda
					</a>
				</div>
			) : product ? (
				<ProductDetail
					client:load
					product={product}
					onAddToCart={handleAddToCart}
					onQuantityChange={handleQuantityChange}
				/>
			) : (
				<div class="flex flex-col items-center justify-center py-12 text-center sm:py-20">
					<div class="h-10 w-10 animate-spin rounded-full border-4 border-muted border-t-primary" />
					<p class="mt-4 text-muted-foreground">Memuat...</p>
				</div>
			)
		}
	</div>
</Layout>
